  "popupTemplate": {
    "title": "{hazard_type} \u00b7 {severity} severity",
    "expressionInfos": [
      {
        "name": "status_badge",
        "title": "Status badge",
        "returnType": "string",
        "expression": "var s = Lower(DefaultValue($feature.status, \"open\"));Decode(s, \"resolved\", \"#16a34a\", \"dispatched\", \"#2563eb\", \"#dc2626\")"
      }
    ],
    "popupElements": [
      {
        "type": "attachments",
        "displayType": "preview",
        "title": "Dashcam capture"
      },
      {
        "type": "text",
        "text": "<p><span style='background-color:{expression/status_badge};color:#fff;padding:2px 8px;border-radius:10px;font-weight:600;text-transform:uppercase;'>{status}</span></p><p><b>{report_count}</b> report(s) &middot; confidence {confidence}</p><p>First seen {detected_at} by {device_id}<br>Last seen {last_reported_at}</p><p>{notes}</p>"
      },
      {
        "type": "fields"
      }
    ],
    "fieldInfos": [
      {
        "fieldName": "hazard_type",
        "label": "Hazard type",
        "visible": true
      },
      {
        "fieldName": "severity",
        "label": "Severity",
        "visible": true
      },
      {
        "fieldName": "status",
        "label": "Repair status",
        "visible": true
      },
      {
        "fieldName": "report_count",
        "label": "Report count",
        "visible": true,
        "format": {
          "places": 0,
          "digitSeparator": true
        }
      },
      {
        "fieldName": "confidence",
        "label": "Detection confidence",
        "visible": true,
        "format": {
          "places": 2
        }
      },
      {
        "fieldName": "device_id",
        "label": "Device ID",
        "visible": true
      },
      {
        "fieldName": "detected_at",
        "label": "First detected",
        "visible": true,
        "format": {
          "dateFormat": "shortDateShortTime"
        }
      },
      {
        "fieldName": "last_reported_at",
        "label": "Last reported",
        "visible": true,
        "format": {
          "dateFormat": "shortDateShortTime"
        }
      },
      {
        "fieldName": "resolved_at",
        "label": "Resolved at",
        "visible": true,
        "format": {
          "dateFormat": "shortDateShortTime"
        }
      },
      {
        "fieldName": "heading_deg",
        "label": "Vehicle heading",
        "visible": false,
        "format": {
          "places": 1
        }
      },
      {
        "fieldName": "bbox_area",
        "label": "BBox area",
        "visible": false,
        "format": {
          "places": 3
        }
      },
      {
        "fieldName": "notes",
        "label": "Crew notes",
        "visible": true
      }
    ],
    "showAttachments": true
  },
