# Copy to esri/.env and fill in ONE auth method.
ARCGIS_URL=https://ucr.maps.arcgis.com

# Option A: ArcGIS built-in account (username/password login, not UCR NetID SSO)
ARCGIS_USERNAME=
ARCGIS_PASSWORD=

# Option B: UCR NetID / SSO. Create an OAuth app in ArcGIS Online
# (Content > New item > Developer credentials > OAuth credentials,
# redirect URL: urn:ietf:wg:oauth:2.0:oob) and paste its Client ID here.
# The script opens a browser link and asks you to paste back the code.
ARCGIS_CLIENT_ID=

# Option C: a token you already have (e.g. an API key with content privileges)
ARCGIS_API_KEY=

# Names / sharing
HAZARD_SERVICE_NAME=dashdigital_road_hazards
WEBSCENE_TITLE=DashDigital Road Hazard Twin
# EVERYONE lets Person 4's dashboard load (and edit status) without a login.
SHARING_LEVEL=EVERYONE

# Google Maps Platform key with "Map Tiles API" enabled (photoreal 3D in the twin preview)
GOOGLE_MAPS_API_KEY=
